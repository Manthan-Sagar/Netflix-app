# ==============================================================================
# Netflix Microservices Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit your actual .env file with live secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS S3 & Cloud Configuration
# ------------------------------------------------------------------------------
# IAM credentials with AmazonS3FullAccess (or scoped permissions for your bucket)
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-netflix-streaming-bucket-name

# ------------------------------------------------------------------------------
# MySQL Database (Content Service)
# ------------------------------------------------------------------------------
# Matches the port mapped in docker-compose.yml (3307:3306)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/content_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ------------------------------------------------------------------------------
# Redis Cache (Streaming Service)
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Apache Kafka (Event Streaming)
# ------------------------------------------------------------------------------
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# FFmpeg & Media Processing (Encoding Service)
# ------------------------------------------------------------------------------
# Windows default: C:/ffmpeg/bin/ffmpeg.exe
# Linux / macOS (if installed via apt/brew): ffmpeg
FFMPEG_PATH=ffmpeg
# Temporary workspace directory for video chunking and HLS segment creation
TEMP_DIR=C:/temp/encoding
